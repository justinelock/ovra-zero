syntax = "v1"

info(
    desc: "投信持仓订单（对接 fb_fund_position / fb_fund_profit_log）"
    author: "ovra"
)

import "../base.api"

type (
    // 持仓列表筛选；对齐 Java FbFundPositionServiceImpl.getWrapper
    InvestPositionQuery {
        Keyword  string `form:"keyword,optional"`  // 用户名/手机/姓名模糊
        FundCode string `form:"fundCode,optional"` // p.fund_code
        Status   string `form:"status,optional"`   // p.status：0 结束 / 1 进行中
    }
    PageSetInvestPositionReq {
        PageReq
        InvestPositionQuery
    }
    // 持仓行；契约见 docs/biz-api.md 4.1
    InvestPositionItem {
        Id             string  `json:"id"`
        UserId         string  `json:"userId,optional"`
        Username       string  `json:"username,optional"`
        Mobile         string  `json:"mobile,optional"`
        RealName       string  `json:"realName,optional"`
        FundCode       string  `json:"fundCode,optional"`
        FundName       string  `json:"fundName,optional"`
        Amount         float64 `json:"amount,optional"`
        BuyDate        string  `json:"buyDate,optional"`
        StartDate      string  `json:"startDate,optional"`
        EndDate        string  `json:"endDate,optional"`
        Period         int     `json:"period,optional"`
        Rate           float64 `json:"rate,optional"`
        Profit         float64 `json:"profit,optional"`
        State          string  `json:"state,optional"`
        Status         int     `json:"status,optional"`
        LastProfitDate string  `json:"lastProfitDate,optional"`
        CreateTime     string  `json:"createTime,optional"`
        UpdateTime     string  `json:"updateTime,optional"`
    }
    PageSetInvestPositionResp {
        Rows  []*InvestPositionItem `json:"rows"`
        Total int64                 `json:"total"`
    }
    // 收益记录筛选；按 userId + positionId 查 fb_fund_profit_log
    InvestPositionOrderQuery {
        UserId     string `form:"userId"`     // 必填
        PositionId string `form:"positionId"` // 必填
    }
    PageSetInvestPositionOrderReq {
        PageReq
        InvestPositionOrderQuery
    }
    // 收益记录行；契约见 docs/biz-api.md 4.1.1
    InvestPositionOrderItem {
        Id               string  `json:"id"`
        UserId           string  `json:"userId,optional"`
        PositionId       string  `json:"positionId,optional"`
        OrderId          string  `json:"orderId,optional"`
        FundCode         string  `json:"fundCode,optional"`
        ProfitDate       string  `json:"profitDate,optional"`
        ProfitDatetime   string  `json:"profitDatetime,optional"`
        Profit           float64 `json:"profit,optional"`           // profit_amount
        CumulativeProfit float64 `json:"cumulativeProfit,optional"`
        Status           int     `json:"status,optional"`
        CreateTime       string  `json:"createTime,optional"`
        UpdateTime       string  `json:"updateTime,optional"`
    }
    PageSetInvestPositionOrderResp {
        Rows  []*InvestPositionOrderItem `json:"rows"`
        Total int64                      `json:"total"`
    }
    // 修改前收益查询；对齐 Java POST /fubang/fbfundposition/profitBefore
    InvestPositionProfitBeforeReq {
        Id         string `json:"id"`
        ProfitDate string `json:"profitDate"` // yyyy-MM-dd
    }
    InvestPositionProfitBeforeResp {
        Profit *float64 `json:"profit"` // 无流水时为 null
    }
    // 修改持仓某日收益；对齐 Java PUT /fubang/fbfundposition/updateProfit
    InvestPositionUpdateProfitReq {
        Id         string  `json:"id"`
        ProfitDate string  `json:"profitDate"` // yyyy-MM-dd
        Profit     float64 `json:"profit"`
    }
)

@server(
    tags: "投信管理"
    group: invest/position
    prefix: /invest/position
    middleware: Auth, Sign
)
service System {
    @handler PageSet
    get /list (PageSetInvestPositionReq) returns (PageSetInvestPositionResp)

    @handler OrderPageSet
    get /order/list (PageSetInvestPositionOrderReq) returns (PageSetInvestPositionOrderResp)

    @handler ProfitBefore
    post /profit/before (InvestPositionProfitBeforeReq) returns (InvestPositionProfitBeforeResp)

    @handler UpdateProfit
    put /profit (InvestPositionUpdateProfitReq)
}
