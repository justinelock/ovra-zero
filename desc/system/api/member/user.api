syntax = "v1"

info(
    desc: "业务用户列表（占位接口，待接业务表）"
    author: "ovra"
)

import "../base.api"

type (
    MemberUserQuery {
        Keyword    string `form:"keyword,optional"`
        AuthStatus string `form:"authStatus,optional"`
        Deleted    string `form:"deleted,optional"`
    }
    PageSetMemberUserReq {
        PageReq
        MemberUserQuery
    }
    MemberUserItem {
        Id              string `json:"id"`
        UserName        string `json:"userName"`
        TotalBalance    string `json:"totalBalance"`
        InvestPosition  string `json:"investPosition"`
        InvestDividend  string `json:"investDividend"`
        RealName        string `json:"realName"`
        OnlineStatus    string `json:"onlineStatus"`
        Status          string `json:"status"`
        InviteCode      string `json:"inviteCode"`
        CreateTime      string `json:"createTime"`
        LastLoginTime   string `json:"lastLoginTime"`
    }
    PageSetMemberUserResp {
        Rows  []*MemberUserItem `json:"rows"`
        Total int64             `json:"total"`
    }
    MemberUserStatsResp {
        TotalActiveSessions int64 `json:"totalActiveSessions"`
    }
)

@server(
    tags: "业务用户"
    group: member/user
    prefix: /member/user
    middleware: Auth, Sign
)
service System {
    @handler Stats
    get /stats (MemberUserQuery) returns (MemberUserStatsResp)

    @handler PageSet
    get /list (PageSetMemberUserReq) returns (PageSetMemberUserResp)
}
