syntax = "v1"

info(
    desc: "提现管理列表（占位接口，待接业务表）"
    author: "ovra"
)

import "../base.api"

type (
    FundWithdrawQuery {
        Keyword        string `form:"keyword,optional"`
        WithdrawStatus string `form:"withdrawStatus,optional"`
        WithdrawType   string `form:"withdrawType,optional"`
    }
    PageSetFundWithdrawReq {
        PageReq
        FundWithdrawQuery
    }
    FundWithdrawItem {
        Id             string `json:"id"`
        UserName       string `json:"userName"`
        RealName       string `json:"realName"`
        WithdrawAmount string `json:"withdrawAmount"`
        UsdtAddress    string `json:"usdtAddress"`
        WithdrawStatus string `json:"withdrawStatus"`
        WithdrawType   string `json:"withdrawType"`
        CreateTime     string `json:"createTime"`
        UpdateTime     string `json:"updateTime"`
    }
    PageSetFundWithdrawResp {
        Rows  []*FundWithdrawItem `json:"rows"`
        Total int64                `json:"total"`
    }
)

@server(
    tags: "资金管理"
    group: fund/withdraw
    prefix: /fund/withdraw
    middleware: Auth, Sign
)
service System {
    @handler PageSet
    get /list (PageSetFundWithdrawReq) returns (PageSetFundWithdrawResp)
}
